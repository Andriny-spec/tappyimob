  sharePassword  String?
  shareToken     String?                 @unique
  permissions    StorageFilePermission[]
  createdBy      User?                   @relation(fields: [createdById], references: [id])
  folder         StorageFolder?          @relation(fields: [folderId], references: [id])

  @@index([folderId])
  @@index([createdById])
  @@index([mimeType])
  @@index([isDeleted])
  @@index([shareToken])
  @@map("storage_files")
}

model StorageFolder {
  id             String                    @id @default(cuid())
  name           String
  color          String?
  icon           String?
  parentId       String?
  createdById    String?
  isPublic       Boolean                   @default(false)
  sharedWith     String[]
  isDeleted      Boolean                   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  ownerId        String?
  ownerType      String?
  shareExpiresAt DateTime?
  sharePassword  String?
  shareToken     String?                   @unique
  files          StorageFile[]
  permissions    StorageFolderPermission[]
  createdBy      User?                     @relation(fields: [createdById], references: [id])
  parent         StorageFolder?            @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children       StorageFolder[]           @relation("FolderHierarchy")

  @@index([parentId])
  @@index([createdById])
  @@index([ownerId])
  @@index([isDeleted])
  @@index([shareToken])
  @@map("storage_folders")
}

model StorageFolderPermission {
  id          String        @id @default(cuid())
  folderId    String
  userId      String
  role        String        @default("VIEWER")
