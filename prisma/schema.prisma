// ─── Sistema Jurídico ─────────────────────────────────────────────────────────

model Negocio {
  id                  String              @id @default(cuid())
  codigo              String              @unique
  fase                NegocioFase         @default(DADOS_RECEBIDOS)
  tipoOperacao        NegocioTipoOperacao @default(PADRAO)
  tipoNegocio         String              @default("VENDA") // VENDA | LOCACAO
  arquivado           Boolean             @default(false)
  arquivadoAt         DateTime?

  // Imóvel
  imovelCondominio    String?
  imovelEndereco      String?
  imovelCep           String?
  imovelLogradouro    String?
  imovelNumero        String?
  imovelComplemento   String?
  imovelCidade        String?
  imovelUf            String?
  imovelMatricula     String?
  imovelMatriculaVencida Boolean          @default(false)
  imovelCri           String?
  imovelInscricaoFiscal String?
  imovelSituacao      String?
  imovelSaldoDevedor  Float?
  imovelBancoCredor   String?
  imovelMobiliario    Boolean             @default(false)
  imovelMobiliarioItens Json?
  imovelLaudemioDetectado Boolean         @default(false)

  // Negócio — financeiro
  valorTotal          Float?
  comissaoPercentual  Float?
  comissaoValor       Float?
  comissaoResponsavel String?
  comissaoVendedorPct Float?
  comissaoCompradorPct Float?
  posseDefinicao      String?
  possePrazo          String?
  posseTextoGerado    String?

  // Permuta
  permutaAtiva        Boolean             @default(false)
  permutaDados        Json?

  // Campos adicionais por tipo (JSON flexível)
  dadosAdicionais     Json?

  // Observações jurídicas (somente admin, não vai para minuta)
  observacoesJuridico String?
  // Caixa de anotações do contrato (comentários, orientações — alimentam a IA)
  anotacoesContrato   String?

  // Controle
  snapshotEnviado     Json?
  snapshotVersao      Int                 @default(0)
  enviadoAt           DateTime?
  corretorId          String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  corretor            User                @relation("NegocioCorretor", fields: [corretorId], references: [id])
  partes              NegocioParte[]
  documentos          NegocioDocumento[]
  parcelas            NegocioParcela[]
  corretores          NegocioCorretorEnvolvido[]
  pendencias          NegocioPendencia[]
  logs                NegocioLog[]
  minutas             NegocioMinuta[]

  @@index([fase])
  @@index([corretorId])
  @@index([tipoOperacao])
  @@map("negocios")
}

model NegocioParte {
  id                  String           @id @default(cuid())
  negocioId           String
  tipo                NegocioTipoParte
  ordem               Int              @default(0)

  // Identificação (Grupo 1 — RG/CNH)
  nome                String?
  cpf                 String?
  nascimento          DateTime?
  filiacaoMae         String?
  filiacaoPai         String?
  nacionalidade       String?

  // Estado civil (Grupo 2 — certidão civil)
  estadoCivil         String?
  regimeBens          String?
  conjuge             String?

  // Endereço (Grupo 3 — comprovante)
  cep                 String?
  logradouro          String?
  numero              String?
  complemento         String?
  cidade              String?
  uf                  String?

  // Contato e bancários (Grupo 4 — sempre manual)
  profissao           String?
  email               String?
  telefone            String?
  banco               String?
  agencia             String?
  conta               String?
  pix                 String?

  // Pessoa Jurídica
  isPessoaJuridica    Boolean          @default(false)
  cnpj                String?
  razaoSocial         String?
  representanteNome   String?
  representanteCpf    String?

  // Procuração
  temProcuracao       Boolean          @default(false)
  procuradorNome      String?
  procuradorCpf       String?

  // Comprador especiais
  usaFgts             Boolean          @default(false)
  fgtsConta           String?
  fgtsBanco           String?
  isEstrangeiro       Boolean          @default(false)

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  negocio             Negocio          @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([negocioId])
  @@map("negocio_partes")
}

