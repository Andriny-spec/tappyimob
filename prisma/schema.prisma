  grantedBy   User?         @relation("StorageFolderPermissionsGranted", fields: [grantedById], references: [id])
  user        User          @relation("StorageFolderPermissions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
  @@index([userId])
  @@index([folderId])
  @@map("storage_folder_permissions")
}

model StorageFilePermission {
  id          String      @id @default(cuid())
