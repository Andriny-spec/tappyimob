  negocioId           String
  campo               String
  descricao           String
  bloqueante          Boolean               @default(false)
  status              NegocioPendenciaStatus @default(ABERTA)
  responsavel         String?
  resolvidoAt         DateTime?
  resolvidoPorId      String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  negocio             Negocio               @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([negocioId])
  @@index([status])
  @@map("negocio_pendencias")
}

model NegocioLog {
  id                  String   @id @default(cuid())
  negocioId           String
  campo               String
  valorAnterior       String?
  valorNovo           String?
  origem              String
  userId              String?
  userName            String?
  createdAt           DateTime @default(now())

  negocio             Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([negocioId])
  @@index([createdAt])
  @@map("negocio_logs")
}

model NegocioMinuta {
  id                  String   @id @default(cuid())
  negocioId           String
  versao              Int      @default(1)
  docxUrl             String?
  docxKey             String?
  geradoPorId         String?
  geradoPorNome       String?
  geradoAt            DateTime @default(now())
  salvoAt             DateTime?
  observacoes         String?

  negocio             Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([negocioId])
  @@map("negocio_minutas")
}

model ContratoTemplate {
  id                  String              @id @default(cuid())
  tipoOperacao        NegocioTipoOperacao @unique
  docxUrl             String
  docxKey             String
  uploadedById        String?
  uploadedByNome      String?
  ativo               Boolean             @default(true)
  aiInstrucao         String?             // Instruções/orientações para a IA ao gerar minutas deste tipo
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("contrato_templates")
}

// Base de conhecimento geral da IA jurídica (singleton — registro único id="default")
model JuridicoIAConfig {
  id               String   @id @default("default")
  baseConhecimento String?  // Referências, diretrizes e instruções gerais para todas as minutas
  updatedAt        DateTime @updatedAt
  updatedByNome    String?

  @@map("juridico_ia_config")
}

// Documentos de referência anexados à base de conhecimento da IA jurídica
// (contratos-modelo, exemplos de formatos, manuais). A equipe anexa e, a
// partir deles, vai escrevendo os macetes na base de conhecimento.
model JuridicoIaReferencia {
  id             String               @id @default(cuid())
  fileName       String
  fileKey        String
  mimeType       String?
  size           Int?
  tipoOperacao   NegocioTipoOperacao? // null = referência geral
  uploadedByNome String?
  createdAt      DateTime             @default(now())

  @@map("juridico_ia_referencias")
}

