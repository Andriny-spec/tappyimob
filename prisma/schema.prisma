generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model LeadTag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  color       String   @default("#6B7280")
  icon        String?
  description String?
  usageCount  Int      @default(0)
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@map("lead_tags")
}

model LeadQueue {
  id                  String                @id @default(cuid())
  name                String
  description         String?
  isActive            Boolean               @default(true)
  rotationType        String                @default("ROUND_ROBIN")
  rules               Json?
  workingHours        Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  responseTimeMinutes Int?
  delayRules          Json?
  assignments         LeadQueueAssignment[]
  members             LeadQueueMember[]

  @@map("lead_queues")
}

model LeadQueueMember {
  id              String    @id @default(cuid())
  weight          Int       @default(1)
  isActive        Boolean   @default(true)
  isPaused        Boolean   @default(false)
  pausedUntil     DateTime?
  pauseReason     String?
  maxLeadsPerDay  Int?
  maxLeadsPerWeek Int?
  maxActiveLeads  Int?
  leadsToday      Int       @default(0)
  leadsThisWeek   Int       @default(0)
  totalLeads      Int       @default(0)
  lastLeadAt      DateTime?
  lastTurnAt      DateTime?
  turnOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  queueId         String
  userId          String
  queue           LeadQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user            User      @relation("QueueMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queueId, userId])
  @@map("lead_queue_members")
}

model LeadQueueAssignment {
  id                 String    @id @default(cuid())
  status             String    @default("PENDING")
  assignedAt         DateTime  @default(now())
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  expiresAt          DateTime?
  reason             String?
  queueId            String
  leadId             String
  assignedToId       String
  assignedById       String?
  previousAssigneeId String?
  queue              LeadQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([assignedToId])
  @@map("lead_queue_assignments")
}

model LeadDuplicate {
  id           String    @id @default(cuid())
  matchType    String
  matchScore   Int       @default(100)
  status       String    @default("PENDING")
  resolvedAt   DateTime?
  resolvedById String?
  resolution   String?
  leadId1      String
  leadId2      String
  corretor1Id  String?
  corretor2Id  String?
  createdAt    DateTime  @default(now())

  @@unique([leadId1, leadId2])
  @@index([status])
  @@map("lead_duplicates")
}

model LeadAutomation {
  id             String    @id @default(cuid())
  name           String
  description    String?
  triggerType    String
  triggerConfig  Json
  actionType     String
  actionConfig   Json
  isActive       Boolean   @default(true)
  priority       Int       @default(0)
  executionCount Int       @default(0)
  lastExecutedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("lead_automations")
}

model LeadAutomationLog {
  id           String   @id @default(cuid())
  automationId String
  leadId       String
  status       String
  result       Json?
  error        String?
  executedAt   DateTime @default(now())

  @@index([automationId])
  @@index([leadId])
  @@map("lead_automation_logs")
}

model LeadEnrichment {
  id            String   @id @default(cuid())
  provider      String
  data          Json
  status        String   @default("SUCCESS")
  error         String?
  cost          Float?
  createdAt     DateTime @default(now())
  leadId        String
  requestedById String?

  @@index([leadId])
  @@index([provider])
  @@map("lead_enrichments")
}

model LeadFollowUp {
  id           String    @id @default(cuid())
  type         String
  status       String    @default("PENDING")
  scheduledFor DateTime
  sentAt       DateTime?
  completedAt  DateTime?
  message      String?
  channel      String?
  leadId       String
  visitId      String?
  assignedToId String?
  createdAt    DateTime  @default(now())

  @@index([leadId])
  @@index([status])
  @@index([scheduledFor])
  @@map("lead_follow_ups")
}

model User {
  id                        String                    @id @default(cuid())
  email                     String                    @unique
  password                  String
  name                      String
  phone                     String?
  avatar                    String?
  role                      Role                      @default(CLIENTE)
  creci                     String?
  bio                       String?
  // Dados do parceiro externo (corretor/imobiliária)
  cpf                       String?
  rg                        String?
  birthDate                 DateTime?
  maritalStatus             String?
  addressFull               String?
  partnerType               String?                   // AUTONOMO | IMOBILIARIA
  agencyName                String?                   // nome da imobiliária (se IMOBILIARIA)
  pixKey                    String?
  // Dados bancários do parceiro (repasse de comissão)
  bankName                  String?                   // banco
  bankAgency                String?                   // agência
  bankAccount               String?                   // conta
  bankAccountType           String?                   // CORRENTE | POUPANCA
  isActive                  Boolean                   @default(true)
  deletedAt                 DateTime?
  emailVerified             DateTime?
  region                    String?
  rating                    Float                     @default(0)
  ratingCount               Int                       @default(0)
  totalSales                Int                       @default(0)
  totalValue                Float                     @default(0)
  conversionRate            Float                     @default(0)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  allowedModules            String[]                  @default([])
  tokenInvalidatedAt        DateTime?
  comissoes                 Comissao[]
  contracts                 Contract[]                @relation("ContractCorretor")
  negocios                  Negocio[]                 @relation("NegocioCorretor")
  favorites                 Favorite[]
  leadActivities            LeadActivity[]            @relation("LeadActivityUser")
  leadImportsAsCorretor     LeadImport[]              @relation("LeadImportCorretor")
  leadImports               LeadImport[]              @relation("LeadImports")
  queueMemberships          LeadQueueMember[]         @relation("QueueMember")
  leads                     Lead[]                    @relation("LeadCorretor")
  leadsCreated              Lead[]                    @relation("LeadCreatedBy")
  metas                     Meta[]
  mindMaps                  MindMap[]
  notifications             Notification[]
  ownerContactLogs          OwnerContactLog[]         @relation("OwnerContactLogs")
  uploadedMedia             PhotoSessionMedia[]
  photographerSlots         PhotoSessionSlot[]        @relation("PhotographerSlots")
  brokerSessions            PhotoSession[]            @relation("BrokerSessions")
  photographerSessions      PhotoSession[]            @relation("PhotographerSessions")
  posts                     Post[]
  propertiesConfirmed       Property[]                @relation("AvailabilityConfirmer")
  properties                Property[]                @relation("PropertyOwner")
  propertiesUpdated         Property[]                @relation("PropertyUpdater")
  propertyActivityLogs      PropertyActivityLog[]     @relation("PropertyActivityLogs")
  propertyObservations      PropertyObservation[]
  priceChanges              PropertyPriceHistory[]    @relation("PriceChangedBy")
  propertyProposals         PropertyProposal[]        @relation("ProposalCorretor")
  timelineAssignments       PropertyTimeline[]        @relation("TimelineAssignedTo")
  timelineCompletions       PropertyTimeline[]        @relation("TimelineCompletedBy")
  scheduledVisitsAsCorretor ScheduledVisit[]          @relation("VisitCorretor")
  scheduledVisitsCreated    ScheduledVisit[]          @relation("VisitCreator")
  storageFileGranted        StorageFilePermission[]   @relation("StorageFilePermissionsGranted")
  storageFilePerms          StorageFilePermission[]   @relation("StorageFilePermissions")
  storageFiles              StorageFile[]
  storageFolderGranted      StorageFolderPermission[] @relation("StorageFolderPermissionsGranted")
  storageFolderPerms        StorageFolderPermission[] @relation("StorageFolderPermissions")
  storageFolders            StorageFolder[]
  tasksAssigned             Task[]                    @relation("TaskAssignedTo")
  tasksCreated              Task[]                    @relation("TaskCreatedBy")
  visits                    Visit[]
  tappyIAConversations    TappyIAConversation[]
  profileLogs               UserProfileLog[]
  passwordResetTokens       PasswordResetToken[]
  pushTokens                PushToken[]

  @@map("users")
  saasAssinante             SaasAssinante?           @relation("SaasAssinanteUsuario")
}

// Histórico de edições cadastrais do usuário (Meus Dados)
model UserProfileLog {
  id        String   @id @default(cuid())
  userId    String
  field     String   // campo alterado (ex: phone, email, bankAccount)
  oldValue  String?
  newValue  String?
  changedBy String?  // quem alterou (id do usuário; normalmente o próprio)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_profile_logs")
}

// Tokens de recuperação de senha (fluxo "esqueceu a senha")
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // hash SHA-256 do token enviado por e-mail
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Tokens de push notification do app (Expo). Um usuário pode ter vários
// aparelhos; cada token é único por instalação.
model PushToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique // token Expo (ExponentPushToken[...])
  platform  String    @default("android") // "ios" | "android"
  deviceId  String?
  lastUsedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
  @@map("push_tokens")
}

model TappyIAConversation {
  id        String              @id @default(cuid())
  userId    String
  title     String              @default("Nova conversa")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TappyIAMessage[]

  @@index([userId, updatedAt])
  @@map("tappy_ia_conversations")
}

model TappyIAMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // "user" | "assistant"
  content        String   @db.Text
  audioUrl       String?  @db.Text
  imageUrl       String?  @db.Text
  imagePrompt    String?  @db.Text
  imageSize      String?
  imageModel     String?
  properties     Json?
  propertyPhotos Json?
  createdAt      DateTime @default(now())

  conversation TappyIAConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("tappy_ia_messages")
}

model Condominium {
  id                       String           @id @default(cuid())
  name                     String
  slug                     String?          @unique
  description              String?
  condoCategory            String           @default("RESIDENCIAL")
  condoType                String           @default("VERTICAL")
  builderId                String?
  address                  String?
  number                   String?
  neighborhood             String?
  city                     String?
  state                    String?
  zipCode                  String?
  latitude                 Float?
  longitude                Float?
  fakeAddress              String?
  fakeNumber               String?
  fakeNeighborhood         String?
  fakeCity                 String?
  fakeState                String?
  fakeZipCode              String?
  showRealAddress          Boolean          @default(false)
  totalUnits               Int?
  totalLots                Int?
  yearBuilt                Int?
  builder                  String?
  availableSizes           String[]
  hasApartment             Boolean          @default(false)
  hasCobertura             Boolean          @default(false)
  hasGarden                Boolean          @default(false)
  hasFlat                  Boolean          @default(false)
  hasStudio                Boolean          @default(false)
  hasHouse                 Boolean          @default(false)
  hasCasaTerrea            Boolean          @default(false)
  hasSobrado               Boolean          @default(false)
  hasTerrain               Boolean          @default(false)
  hasCommercial            Boolean          @default(false)
  amenities                String[]
  hasSportsAdvisory        Boolean          @default(false)
  activityScheduleImage    String?
  adminName                String?
  adminPhone               String?
  adminEmail               String?
  porterPhone              String?
  contacts                 Json?
  managementCompany        String?
  managementCompanyPhone   String?
  managementCompanyEmail   String?
  managementCompanyWebsite String?
  isLaunchProject          Boolean          @default(false)
  launchStage              String?
  expectedDelivery         DateTime?
  launchDescription        String?
  thumbnail                String?
  images                   String[]
  videos                   String[]
  virtualTour              String?
  internalMap              String?
  maps                     Json?
  implantation             String?
  floorPlans               Json?
  metaTitle                String?
  metaDescription          String?
  isActive                 Boolean          @default(true)
  isFeatured               Boolean          @default(false)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  towers                   CondoTower[]
  builderPartner           BusinessPartner? @relation("CondominiumBuilder", fields: [builderId], references: [id])
  properties               Property[]

  @@map("condominiums")
}

model CondoTower {
  id             String      @id @default(cuid())
  name           String
  floors         Int?
  unitsPerFloor  Int?
  totalUnits     Int?
  availableSizes String[]
  condominiumId  String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  condominium    Condominium @relation(fields: [condominiumId], references: [id], onDelete: Cascade)

  @@map("condo_towers")
}

model PropertyCustomOption {
  id        Int      @id @default(autoincrement())
  category  String
  value     String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([category, value])
  @@map("property_custom_options")
}

model Property {
  id                        String                   @id @default(cuid())
  code                      String                   @unique
  title                     String
  marketplaceTitle          String?
  slug                      String?                  @unique
  description               String
  shortDescription          String?
  condoDescription          String?
  exchangeDescription       String?
  condominiumId             String?
  towerName                 String?
  unitNumber                String?
  propertyClass             PropertyClass            @default(RESIDENCIAL)
  type                      PropertyType
  subType                   PropertySubType?
  category                  PropertyCategory         @default(VENDA)
  condition                 PropertyCondition        @default(USADO)
  expectedCompletionDate    DateTime?
  status                    PropertyStatus           @default(DISPONIVEL)
  saleStatus                FinalityStatus?
  rentalStatus              FinalityStatus?
  price                     Float
  rentPrice                 Float?
  seasonalPrice             Float?
  auctionPrice              Float?
