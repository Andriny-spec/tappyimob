model PropertyPriceHistory {
  id            String   @id @default(cuid())
  propertyId    String
  oldPrice      Float
  newPrice      Float
  priceType     String   @default("SALE")
  changeType    String   @default("REDUCTION")
  changeAmount  Float
  changePercent Float
  changedById   String?
  notes         String?
  createdAt     DateTime @default(now())
  changedBy     User?    @relation("PriceChangedBy", fields: [changedById], references: [id])
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([changeType])
  @@map("property_price_history")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  source    String? // footer | blog
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

model PropertyViewLog {
  id         String   @id @default(cuid())
  propertyId String
  source     String   @default("site")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@index([createdAt])
  @@index([source, createdAt])
  @@map("property_view_logs")
}

model OwnerContactLog {
  id          String         @id @default(cuid())
  propertyId  String
  ownerId     String?
  userId      String
  contactType String
  phoneNumber String?
  createdAt   DateTime       @default(now())
  owner       PropertyOwner? @relation(fields: [ownerId], references: [id])
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user        User           @relation("OwnerContactLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@index([userId, createdAt])
  @@index([ownerId, createdAt])
  @@map("owner_contact_logs")
}

model PropertyEvaluation {
  id         String   @id @default(cuid())
  value      Float
  notes      String?
  evaluator  String
  date       DateTime @default(now())
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_evaluations")
}

model PropertyOwner {
  id                      String                    @id @default(cuid())
  name                    String
  email                   String?
  phones                  String[]
  birthDate               DateTime?
  profile                 OwnerProfile              @default(PROPRIETARIO)
  cpf                     String?
  rg                      String?
  maritalStatus           String?
  residentialAddress      String?
  residentialNumber       String?
  residentialComplement   String?
  residentialNeighborhood String?
  residentialCity         String?
  residentialState        String?
  residentialZipCode      String?
  notes                   String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  phoneContacts           Json?
  emails                  String[]
  ownerContactLogs        OwnerContactLog[]
  properties              Property[]
  attachments             PropertyOwnerAttachment[]

  @@map("property_owners")
}

model PropertyOwnerAttachment {
  id        String        @id @default(cuid())
  name      String
  type      String
  url       String
  ownerId   String
  createdAt DateTime      @default(now())
  owner     PropertyOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("property_owner_attachments")
}

model PropertyOwnerHistory {
  id         String    @id @default(cuid())
  type       String
  name       String
  cpf        String?
  email      String?
  phone      String?
  startDate  DateTime?
  endDate    DateTime?
  notes      String?
  propertyId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_owner_history")
}

model PropertyDocument {
  id              String   @id @default(cuid())
  matriculaNumber String?
  matriculaUrl    String?
  iptuNumber      String?
  iptuUrl         String?
  certidaoSPU     String?
  certidaoSPUUrl  String?
