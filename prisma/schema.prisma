// Disparo (job) em massa — um registro por "click" em Disparar (WhatsApp ou Email)
model EventBlast {
  id              String                @id @default(cuid())
  eventSlug       String                @default("tappy-summit-2026")
  channel         String                @default("whatsapp") // whatsapp | email
  sessionName     String?
  subject         String?               // usado só para canal email
  message         String                // whatsapp: texto; email: HTML
  mediaUrl        String?
  mediaType       String?
  voiceUrl        String?
  voiceFirst      Boolean               @default(false)
  delayMs         Int                   @default(4000)
  totalRecipients Int                   @default(0)
  sentCount       Int                   @default(0)
  errorCount      Int                   @default(0)
  status          String                @default("running") // running | completed | aborted | failed
  createdById     String?
  createdByName   String?
  startedAt       DateTime              @default(now())
  finishedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  recipients      EventBlastRecipient[]

  @@index([eventSlug, createdAt])
  @@index([channel, createdAt])
  @@index([status])
  @@map("event_blasts")
}

// Destinatário individual de um blast com status/timestamp/erro
model EventBlastRecipient {
  id             String     @id @default(cuid())
  blastId        String
  registrationId String?
  name           String
  phone          String     @default("")
  email          String     @default("")
  status         String     @default("pending") // pending | sent | failed
  error          String?
  sentAt         DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  blast          EventBlast @relation(fields: [blastId], references: [id], onDelete: Cascade)

  @@index([blastId, status])
  @@index([registrationId])
  @@index([phone])
  @@map("event_blast_recipients")
}

