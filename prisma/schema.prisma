  hasFinancingBalance       Boolean                  @default(false)
  financingBalance          Float?
  financingBank             String?
  hasIrregularDocs          Boolean                  @default(false)
  irregularDocsNotes        String?
  isCornerHouse             Boolean?
  hasNonBuildableArea       Boolean?
  area                      Float
  totalArea                 Float?
  usefulArea                Float?
  bedrooms                  Int                      @default(0)
  suites                    Int                      @default(0)
  bathrooms                 Int                      @default(0)
  parkingSpaces             Int                      @default(0)
  coveredParkingSpaces      Int?
  floor                     Int?
  totalFloors               Int?
  unitsPerFloor             Int?
  position                  String?
  sunPosition               String?
  yearBuilt                 Int?
  propertyAge               String?
  address                   String
  number                    String?
  complement                String?
  neighborhood              String
  city                      String
  state                     String
  country                   String                   @default("Brasil")
  zipCode                   String?
  latitude                  Float?
  longitude                 Float?
  addressVisibility         AddressVisibility        @default(COMPLETO)
  thumbnail                 String?
  images                    String[]
  videos                    String[]
  videoYoutube              String?
  virtualTour               String?
  plants                    String[]
  amenities                 String[]
  features                  String[]
  extras                    String[]
  nearbyPlaces              String[]
  hasElevator               Boolean                  @default(false)
  isFurnished               Boolean                  @default(false)
  hasGroundFloorSuite       Boolean                  @default(false)
  hasFreeView               Boolean                  @default(false)
  acceptsPets               Boolean?
  rentalWarranties          String[]
  landTopography            String?
  landFrontWidth            Float?
  landDepth                 Float?
  hasApprovedProject        Boolean?
  isGroundFloor             Boolean?
  metaTitle                 String?
  metaDescription           String?
  tags                      String[]
  rating                    Float                    @default(0)
  ratingCount               Int                      @default(0)
  hasPlate                  Boolean                  @default(false)
  isOccupied                Boolean                  @default(false)
  showOnWebsite             Boolean                  @default(true)
  isOffMarket               Boolean                  @default(false)
  activePortals             String[]
  portalPositions           Json?
  isFeatured                Boolean                  @default(false)
  isExclusive               Boolean                  @default(false)
  isThirdPartyExclusive     Boolean                  @default(false)
  exclusivityManagerId      String?
  isNew                     Boolean                  @default(false)
  isSuperFeatured           Boolean                  @default(false)
  portalHighlight           String?
  highlights                String[]
  websiteCategories         String[]
  hasPartnerCondition       Boolean                  @default(false)
  partnerConditionType      String?
  partnerConditionValue     String?
  partnerConditionDesc      String?
  partnerConditionExpiry    DateTime?
  views                     Int                      @default(0)
  portalViews               Int                      @default(0)
  clicks                    Int                      @default(0)
  favorites                 Int                      @default(0)
  shares                    Int                      @default(0)
  inPersonVisits            Int                      @default(0)
  proposalsCount            Int                      @default(0)
  soldBy                    String?
  soldAt                    DateTime?
  soldPrice                 Float?
  soldNotes                 String?
